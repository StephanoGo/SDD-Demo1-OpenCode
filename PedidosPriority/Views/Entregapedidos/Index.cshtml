@model IEnumerable<PedidosPriority.Models.Order>
@{
    ViewData["Title"] = "Pedidos en Cola";
}

<div class="page-head">
    <h1>Pedidos en Cola</h1>
    <p class="page-subtitle">Pedidos activos en preparación según prioridad y orden de registro.</p>
</div>

<div class="toolbar">
    <div class="search-box">
        <svg class="icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.35-4.35" />
        </svg>
        <input type="search" id="filtro-cola" placeholder="Buscar cliente o dirección..." aria-label="Buscar cliente o dirección" />
    </div>
    <button type="button" id="limpiar-filtros" class="btn btn-outline">Limpiar filtros</button>
</div>

<div class="card card-table">
    <table class="table" id="tabla-cola">
        <thead>
            <tr>
                <th>Turno</th>
                <th>Cliente</th>
                <th>Número telefónico</th>
                <th>Dirección</th>
                <th>Subtotal</th>
                <th>Envío</th>
                <th>Total</th>
                <th>Prioridad</th>
                <th>Tipo de entrega</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody id="queue-body"></tbody>
        <tfoot>
            <tr class="table-footer">
                <td colspan="10">Mostrando <span id="queue-count">0</span> pedidos activos en preparación | Tiempo estimado medio: 18 mins</td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
    window.pedidosColaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
</script>