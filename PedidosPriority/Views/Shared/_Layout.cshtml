<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PedidosPriority</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-area="" asp-controller="Pedidos" asp-action="Index">
                <svg class="brand-mark" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7E7469" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1.5 8h13v9h-13z" />
                    <path d="M14.5 11h4l3.5 3.5V17h-7.5" />
                    <circle cx="6" cy="19" r="1.6" />
                    <circle cx="16.5" cy="19" r="1.6" />
                </svg>
                <span>PedidosPriority</span>
            </a>
            <div class="nav-pill" role="navigation" aria-label="Navegación principal">
                <a class="nav-tab @(currentController == "Pedidos" ? "active" : "")" asp-area="" asp-controller="Pedidos" asp-action="Index">
                    <svg class="nav-tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Registrar Pedido
                </a>
                <a class="nav-tab @(currentController == "Entregapedidos" ? "active" : "")" asp-area="" asp-controller="Entregapedidos" asp-action="Index">
                    <svg class="nav-tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="3" />
                        <path d="M3 9h18" />
                        <path d="M8 14h6" />
                    </svg>
                    Pedidos en Cola
                </a>
                <span class="nav-tab nav-tab-consulta" title="Consultar el detalle de una orden">
                    <svg class="nav-tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7E7469" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1.5 8h13v9h-13z" />
                        <path d="M14.5 11h4l3.5 3.5V17h-7.5" />
                        <circle cx="6" cy="19" r="1.6" />
                        <circle cx="16.5" cy="19" r="1.6" />
                    </svg>
                    <span class="nav-tab-label">Ver detalles de la orden</span>
                    <input type="number" id="detalle-id" class="nav-tab-input" min="1" step="1" placeholder="ID" aria-label="ID de la orden" />
                    <button type="button" id="btn-ver-detalle" class="nav-tab-btn">Ver</button>
                </span>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">&copy; 2026 - PedidosPriority.</div>
    </footer>
    <script>
        window.detalleBaseUrl = '@Url.Action("Detalle", "Pedidos")';
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>